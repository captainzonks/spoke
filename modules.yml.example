# ==============================================================================
# MODULES.YML - SPOKE MODULE REGISTRY
# ==============================================================================
# Description: Defines which modules to deploy and their site-specific config
# Author: Matt Barham
# Created: 2026-02-12
# Modified: 2026-09-26
# Version: 1.1.0
# Host: Your Server
# ==============================================================================
# Type: Template
# Security Level: MEDIUM - Site topology and secret path mappings (no secrets)
# Component: Spoke module registry
# ==============================================================================
# INSTRUCTIONS:
#   1. Copy this file to modules.yml
#   2. Update repo URLs, IPs, and secrets_map for your deployment
#   3. Set enabled: false for modules you don't want
#   4. Never commit modules.yml (it's gitignored)
#
# MODULE ORDER MATTERS:
#   boot_deploy.sh deploys modules in the key order below, not alphabetically.
#   Compose `depends_on` cannot cross module boundaries, so a module whose
#   services consume another module's services must be listed AFTER it.
#   Known consumers: monitoring -> database (loki and prometheus store chunks
#   in minio, telegraf writes influxdb3, grafana reads victoria-metrics).
#
# OPTIONAL PER-MODULE KEYS:
#   boot_deploy: false   Skip this module during boot_deploy.sh. For modules
#                        driven entirely by their own systemd timer, where a
#                        deploy at boot just burns a scheduled cycle. Absent
#                        key means true.
# ==============================================================================

platform:
  name: spoke
  version: 1.0.0

instance:
  name: myserver
  domain: example.com

modules:
  # --- Infrastructure Modules ---

  # database first: monitoring's loki, prometheus, telegraf and grafana all
  # read or write services defined here.
  database:
    repo: "https://github.com/captainzonks/spoke-database.git"
    ref: "main"
    enabled: false

  monitoring:
    repo: "https://github.com/captainzonks/spoke-monitoring.git"
    ref: "main"
    enabled: false
    env_overrides:
      GRAFANA_IP: "192.168.35.102"
      PROMETHEUS_IP: "192.168.35.109"
    secrets_map:
      grafana_admin_password: "secrets/grafana/grafana_admin_password"

  triage:
    repo: "https://github.com/captainzonks/spoke-triage.git"
    ref: "main"
    enabled: false
    # Batch job on its own systemd timer. Deploying it at boot starts a
    # collector run whose window the next timed run supersedes.
    boot_deploy: false
    secrets_map:
      triage_app_psql_password: "secrets/triage/triage_app_psql_password"
      anthropic_api_key: "secrets/triage/anthropic_api_key"

  power:
    repo: "https://github.com/captainzonks/spoke-power.git"
    ref: "main"
    enabled: false

  torrenting:
    repo: "https://github.com/captainzonks/spoke-torrenting.git"
    ref: "main"
    enabled: false
    env_overrides:
      GLUETUN_IP: "192.168.35.80"
      QBITTORRENT_IP: "192.168.35.82"
    secrets_map:
      vpn_wireguard_private_key: "secrets/vpn/wireguard_private_key"

  plex:
    repo: "https://github.com/captainzonks/spoke-plex.git"
    ref: "main"
    enabled: false
    env_overrides:
      PLEX_IP: "192.168.35.83"
      TAUTULLI_IP: "192.168.35.87"

  music:
    repo: "https://github.com/captainzonks/spoke-music.git"
    ref: "main"
    enabled: false

  protonmail:
    repo: "https://github.com/captainzonks/spoke-protonmail.git"
    ref: "main"
    enabled: false

  homepage:
    repo: "https://github.com/captainzonks/spoke-homepage.git"
    ref: "main"
    enabled: false

  foundryvtt:
    repo: "https://github.com/captainzonks/spoke-foundryvtt.git"
    ref: "main"
    enabled: false

  immich:
    repo: "https://github.com/captainzonks/spoke-immich.git"
    ref: "main"
    enabled: false
